generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// System & Access Management
// ----------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  email        String      @unique
  firstName    String
  lastName     String
  employeeId   String      @unique
  mobile       String
  department   String?
  status       UserStatus  @default(ACTIVE)
  roleId       String
  branchId     String
  lastLogin    DateTime?
  failedLogins Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  role         Role        @relation(fields: [roleId], references: [id])
  branch       Branch      @relation(fields: [branchId], references: [id])

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String?  @unique
  name        String   @unique
  description String
  isSystem    Boolean  @default(false)
  permissions String[] // List of permission keys
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@map("roles")
}

model Branch {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  addressLine1        String?
  addressLine2        String?
  city                String
  state               String
  pinCode             String?
  phone               String?
  email               String?
  managerId           String?
  managerName         String?
  region              String?  @default("West")
  status              String   @default("ACTIVE")
  activeLoanCount     Int      @default(0)
  totalPortfolioValue Decimal? @db.Decimal(16, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
  customers           Customer[]
  loans               LoanAccount[]

  @@map("branches")
}

// ----------------------------------------------------
// Audit Trail
// ----------------------------------------------------

enum AuditEntityType {
  USER
  ROLE
  BRANCH
  PERMISSION
  APPLICATION
  SANCTION
  DISBURSEMENT
  CUSTOMER
  CREDIT_ASSESSMENT
  APPROVAL
  SETTINGS
}

model AdminAuditLog {
  id         String          @id @default(uuid())
  timestamp  DateTime        @default(now())
  actorId    String
  actorName  String
  actorRole  String
  entityType AuditEntityType
  entityId   String
  entityName String
  action     String
  details    String
  reason     String?
  changes    Json?
  ipAddress  String

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("admin_audit_logs")
}

model ApplicationSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String
  label       String?
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([category])
  @@map("application_settings")
}

// ----------------------------------------------------
// Customers & KYC Management
// ----------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerRecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Customer {
  id                   String               @id @default(uuid())
  customerNumber       String               @unique
  firstName            String
  middleName           String?
  lastName             String
  name                 String
  dateOfBirth          String
  gender               String               @default("MALE")
  maritalStatus        String?
  nationality          String               @default("Indian")
  customerType         CustomerType         @default(INDIVIDUAL)
  mobile               String
  alternateMobile      String?
  email                String?
  preferredContact     String               @default("MOBILE")
  currentAddress       Json
  permanentAddress     Json
  sameAsCurrentAddress Boolean              @default(true)
  employmentType       String               @default("SALARIED")
  employerName         String?
  occupation           String?
  monthlyIncome        Decimal              @db.Decimal(14, 2)
  employmentSince      String?
  bankName             String?
  accountNumberMasked  String?
  accountNumber        String?
  ifscCode             String?
  branchId             String
  branchName           String
  status               CustomerRecordStatus @default(ACTIVE)
  assignedOfficer      String?
  activeLoanCount      Int                  @default(0)
  closedLoanCount      Int                  @default(0)
  totalOutstanding     Decimal              @default(0.00) @db.Decimal(14, 2)
  totalOverdue         Decimal              @default(0.00) @db.Decimal(14, 2)
  cibilScore           Int?
  panMasked            String?
  aadhaarMasked        String?
  archivedReason       String?
  archivedDate         DateTime?
  archivedBy           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  branch               Branch               @relation(fields: [branchId], references: [id])
  kycRecords           KycRecord[]
  documents            DocumentItem[]
  applications         LoanApplication[]
  loans                LoanAccount[]
  disbursements        Disbursement[]
  payments             Payment[]
  history              CustomerHistory[]
  recoveryCases        RecoveryCase[]
  legalCases           LegalCase[]
  restructuringRequests RestructuringRequest[]
  charges              LoanCharge[]
  waiverRequests       WaiverRequest[]
  financialAdjustments FinancialAdjustmentRequest[]
  closureRequests      LoanClosureRequest[]
  nocRecords           NocRecord[]

  @@map("customers")
}

model CustomerHistory {
  id              String   @id @default(uuid())
  customerId      String
  timestamp       DateTime @default(now())
  eventType       String
  title           String
  actor           String
  actorRole       String
  entityReference String?
  description     String
  module          String
  metadata        Json?

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_history")
}

model KycRecord {
  id                    String   @id @default(uuid())
  customerId            String
  customerNumber        String
  customerName          String
  customerType          String   @default("INDIVIDUAL")
  status                String   @default("VERIFIED")
  kycLevel              String   @default("TIER_3_FULL_CKYC")
  riskCategory          String   @default("LOW")
  cKycNumber            String?
  panRecord             Json?
  aadhaarRecord         Json?
  secondaryIdRecord     Json?
  videoKycRecord        Json?
  antiMoneyLaundering   Json?
  riskAssessment        Json?
  comments              Json?
  verifiedAt            DateTime?
  verifiedBy            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("kyc_records")
}

model DocumentItem {
  id             String    @id @default(uuid())
  customerId     String
  documentNumber String?
  title          String
  category       String
  documentType   String
  fileFormat     String    @default("PDF")
  fileSizeKb     Int       @default(0)
  fileUrl        String?
  status         String    @default("VERIFIED")
  uploadedAt     DateTime  @default(now())
  uploadedBy     String
  verifiedAt     DateTime?
  verifiedBy     String?
  rejectionNote  String?
  ocrExtracted   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("documents")
}

// ----------------------------------------------------
// Loan Products
// ----------------------------------------------------

model LoanProduct {
  id                    String                    @id @default(uuid())
  code                  String                    @unique // e.g. HL-PRIME, PL-EXEC, VL-AUTO, BL-SME, GL-GOLD
  name                  String                    // e.g. Home Loan Prime
  category              String                    // HOUSING, PERSONAL, VEHICLE, BUSINESS, GOLD, EDUCATION, RETAIL, SME
  description           String?
  minAmount             Decimal                   @db.Decimal(14, 2)
  maxAmount             Decimal                   @db.Decimal(14, 2)
  minTenureMonths       Int
  maxTenureMonths       Int
  baseInterestRate      Decimal                   @db.Decimal(5, 2)
  maxInterestRate       Decimal?                  @db.Decimal(5, 2)
  interestMethod        String                    @default("REDUCING_BALANCE") // REDUCING_BALANCE, FLAT_RATE, SIMPLE_INTEREST
  repaymentFrequency    String                    @default("MONTHLY") // MONTHLY, WEEKLY, BI_WEEKLY, QUARTERLY
  processingFeePercent  Decimal?                  @default(1.0) @db.Decimal(5, 2)
  processingFeeFlat     Decimal?                  @default(0.00) @db.Decimal(14, 2)
  documentationCharges  Decimal?                  @default(750) @db.Decimal(10, 2)
  allowedFrequencies    String[]                  @default(["MONTHLY"])
  requiredDocumentTypes Json?
  eligibilityCriteria   Json?                     // Structured criteria (income, age, employment)
  minCreditScore        Int?                      @default(650)
  status                String                    @default("ACTIVE") // DRAFT, ACTIVE, INACTIVE, ARCHIVED
  version               Int                       @default(1)
  activeFormVersionId   String?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  formTemplates         ApplicationFormTemplate[]
  applications          LoanApplication[]

  @@index([category])
  @@index([status])
  @@map("loan_products")
}

// ----------------------------------------------------
// Loan Applications & Workflow
// ----------------------------------------------------

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENT_PENDING
  CREDIT_ASSESSMENT
  CREDIT_ASSESSED
  APPROVED
  SANCTIONED
  DISBURSED
  REJECTED
  CANCELLED
}

model LoanApplication {
  id                         String            @id @default(uuid())
  applicationNumber          String            @unique
  customerId                 String
  customerNumber             String
  customerName               String
  customerMobile             String?
  customerEmail              String?
  customerKycStatus          String?
  customerMonthlyIncome      Decimal?          @db.Decimal(14, 2)
  customerEmploymentType     String?
  customerExistingLoansCount Int?              @default(0)
  customerTotalExposure      Decimal?          @db.Decimal(14, 2)
  productCode                String
  productName                String
  requestedAmount            Decimal           @db.Decimal(14, 2)
  approvedAmount             Decimal?          @db.Decimal(14, 2)
  sanctionedAmount           Decimal?          @db.Decimal(14, 2)
  requestedTenureMonths      Int               @default(36)
  interestRate               Decimal           @db.Decimal(5, 2)
  repaymentFrequency         String            @default("MONTHLY")
  preferredRepaymentDate     Int?              @default(5)
  purpose                    String?
  purposeCategory            String?           @default("PERSONAL")
  branchId                   String
  branchName                 String?
  loanOfficer                String?
  assignedOfficerId          String?
  status                     ApplicationStatus @default(DRAFT)
  priority                   String            @default("MEDIUM")
  notes                      String?
  submissionDeclarations     Json?
  submittedAt                DateTime?
  submittedBy                String?
  rejectionReason            String?
  cancellationReason         String?
  productId                  String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  customer                   Customer          @relation(fields: [customerId], references: [id])
  product                    LoanProduct?      @relation(fields: [productId], references: [id])
  coApplicants               CoApplicant[]
  guarantors                 Guarantor[]
  documents                  ApplicationDocument[]
  history                    ApplicationHistory[]
  creditAssessments          CreditAssessment[]
  approvals                  ApprovalRecord[]
  sanctions                  Sanction[]
  loans                      LoanAccount[]
  disbursements              Disbursement[]
  formResponse               LoanApplicationFormResponse?

  @@index([productId])
  @@map("loan_applications")
}

model CoApplicant {
  id                 String          @id @default(uuid())
  applicationId      String
  customerId         String
  customerNumber     String
  customerName       String
  mobile             String
  relationship       String
  kycStatus          String          @default("VERIFIED")
  monthlyIncome      Decimal?        @db.Decimal(14, 2)
  panMasked          String?
  existingLoansCount Int?            @default(0)
  totalOutstanding   Decimal?        @db.Decimal(14, 2)
  notes              String?
  addedAt            DateTime        @default(now())
  addedBy            String

  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("co_applicants")
}

model Guarantor {
  id                String          @id @default(uuid())
  applicationId     String
  customerId        String
  customerNumber    String
  customerName      String
  mobile            String
  relationship      String
  guaranteeType     String          @default("INDIVIDUAL")
  kycStatus         String          @default("VERIFIED")
  netWorthEstimated Decimal?        @db.Decimal(14, 2)
  panMasked         String?
  notes             String?
  addedAt           DateTime        @default(now())
  addedBy           String

  application       LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("guarantors")
}

model ApplicationDocument {
  id              String          @id @default(uuid())
  applicationId   String
  documentType    String
  documentTitle   String
  source          String          @default("APPLICATION_UPLOAD")
  documentVaultId String?
  fileName        String?
  fileFormat      String?         @default("PDF")
  fileSizeKb      Int?            @default(0)
  status          String          @default("UPLOADED")
  isMandatory     Boolean         @default(true)
  uploadedAt      DateTime?       @default(now())
  uploadedBy      String?
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  notes           String?

  application     LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_documents")
}

model ApplicationHistory {
  id            String          @id @default(uuid())
  applicationId String
  eventType     String?
  action        String?
  actor         String?
  actorName     String?
  actorRole     String
  timestamp     DateTime        @default(now())
  description   String?
  details       String?
  notes         String?
  metadata      Json?

  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_history")
}

// ----------------------------------------------------
// Credit Assessment
// ----------------------------------------------------

model CreditAssessment {
  id                   String          @id @default(uuid())
  assessmentNumber     String          @unique
  applicationId        String
  applicationNumber    String
  customerId           String
  customerNumber       String
  customerName         String
  status               String          @default("IN_PROGRESS")
  riskCategory         String          @default("LOW")
  creditScore          Int             @default(750)
  monthlyIncome        Decimal         @db.Decimal(14, 2)
  existingObligations  Decimal         @default(0.00) @db.Decimal(14, 2)
  proposedEmi          Decimal         @db.Decimal(14, 2)
  foirPercent          Decimal         @db.Decimal(5, 2)
  maxEligibleAmount    Decimal         @db.Decimal(14, 2)
  recommendedAmount    Decimal         @db.Decimal(14, 2)
  recommendedTenure    Int
  recommendedRate      Decimal         @db.Decimal(5, 2)
  recommendationStatus String          @default("RECOMMEND_APPROVAL")
  rationale            String?
  bureauDetails        Json?
  financialRatios      Json?
  obligations          Json?
  conditions           Json?
  deviations           Json?
  policyRules          Json?
  assignedOfficer      String?
  completedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  application          LoanApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@map("credit_assessments")
}

// ----------------------------------------------------
// Approvals & Approval Matrix
// ----------------------------------------------------

model ApprovalRecord {
  id                 String              @id @default(uuid())
  approvalNumber     String              @unique
  applicationId      String
  applicationNumber  String
  assessmentId       String?
  customerId         String
  customerName       String
  productCode        String
  productName        String
  requestedAmount    Decimal             @db.Decimal(14, 2)
  recommendedAmount  Decimal             @db.Decimal(14, 2)
  approvedAmount     Decimal?            @db.Decimal(14, 2)
  interestRate       Decimal             @db.Decimal(5, 2)
  tenureMonths       Int
  status             String              @default("PENDING")
  requiredRoleLevel  String?
  assignedToRole     String?
  assignedToUser     String?
  currentStage       String?             @default("CREDIT_COMMITTEE")
  approvalDecision   String?
  decisionReason     String?
  conditions         ApprovalCondition[]
  exceptions         Json?
  decisionTrail      Json?
  sanctionGenerated  Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  application        LoanApplication     @relation(fields: [applicationId], references: [id])
  sanctions          Sanction[]

  @@index([applicationId])
  @@map("approval_records")
}

model ApprovalCondition {
  id           String         @id @default(uuid())
  approvalId   String
  category     String
  conditionText String
  status       String         @default("PENDING")
  addedBy      String
  addedAt      DateTime       @default(now())
  resolvedBy   String?
  resolvedAt   DateTime?
  resolution   String?

  approval     ApprovalRecord @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("approval_conditions")
}

model ApprovalMatrixRule {
  id                String   @id @default(uuid())
  ruleCode          String   @unique
  roleName          String
  maxApprovalLimit  Decimal  @db.Decimal(16, 2)
  allowedProducts   String[]
  requiresCommittee Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("approval_matrix_rules")
}

// ----------------------------------------------------
// Sanctions & Sanction Letters
// ----------------------------------------------------

model Sanction {
  id                    String                  @id @default(uuid())
  sanctionNumber        String                  @unique
  applicationId         String
  applicationNumber     String
  approvalId            String?
  approvalNumber        String?
  customerId            String
  customerNumber        String
  customerName          String
  customerMobile        String?
  customerEmail         String?
  customerAddress       String?
  branchId              String
  branchName            String?
  productCode           String
  productName           String
  status                String                  @default("DRAFT")
  requestedAmount       Decimal                 @db.Decimal(14, 2)
  approvedAmount        Decimal                 @db.Decimal(14, 2)
  approvedTenureMonths  Int
  approvedInterestRate  Decimal                 @db.Decimal(5, 2)
  finalApproverName     String?
  finalApproverRole     String?
  approvedDate          String?
  terms                 Json?
  conditions            SanctionCondition[]
  letters               SanctionLetterVersion[]
  auditTrail            Json?
  confirmedBy           String?
  confirmedAt           DateTime?
  expiryDate            DateTime?
  letterGeneratedAt     DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  application           LoanApplication         @relation(fields: [applicationId], references: [id])
  approval              ApprovalRecord?         @relation(fields: [approvalId], references: [id])
  disbursements         Disbursement[]
  loans                 LoanAccount[]

  @@index([applicationId])
  @@index([approvalId])
  @@map("sanctions")
}

model SanctionCondition {
  id             String   @id @default(uuid())
  sanctionId     String
  category       String
  description    String
  status         String   @default("PENDING")
  requiredBefore String   @default("DISBURSEMENT")
  dueDate        String?
  owner          String?
  source         String?  @default("SYSTEM")
  addedBy        String?
  addedAt        DateTime @default(now())
  resolvedBy     String?
  resolvedAt     DateTime?

  sanction       Sanction @relation(fields: [sanctionId], references: [id], onDelete: Cascade)

  @@index([sanctionId])
  @@map("sanction_conditions")
}

model SanctionLetterVersion {
  id              String    @id @default(uuid())
  sanctionId      String
  version         Int       @default(1)
  letterRefNumber String?
  templateId      String?
  status          String    @default("GENERATED")
  htmlContent     String?   @db.Text
  generatedBy     String
  generatedAt     DateTime  @default(now())
  issuedBy        String?
  issuedAt        DateTime?
  downloadUrl     String?

  sanction        Sanction  @relation(fields: [sanctionId], references: [id], onDelete: Cascade)

  @@index([sanctionId])
  @@map("sanction_letters")
}

// ----------------------------------------------------
// Disbursements & Payment Transactions
// ----------------------------------------------------

enum DisbursementStatus {
  DRAFT
  VERIFICATION_PENDING
  READY
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  SUCCESSFUL
  RETURNED
  REJECTED
  FAILED
  REVERSED
  CANCELLED
}

enum DisbursementType {
  FULL
  PARTIAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
  CANCELLED
}

enum PaymentMethod {
  NEFT
  RTGS
  IMPS
  DIRECT_TRANSFER
  ACH
}

model Disbursement {
  id                   String                    @id @default(uuid())
  disbursementNumber   String                    @unique
  applicationId        String
  applicationNumber    String
  sanctionId           String
  sanctionNumber       String
  customerId           String
  customerNumber       String
  customerName         String
  customerMobile       String?
  productCode          String
  productName          String
  branchId             String
  branchName           String?
  sanctionAmount       Decimal                   @db.Decimal(14, 2)
  totalDisbursedAmount Decimal                   @default(0.00) @db.Decimal(14, 2)
  remainingAmount      Decimal                   @db.Decimal(14, 2)
  status               DisbursementStatus        @default(DRAFT)
  firstDisbursedAt     DateTime?
  lastDisbursedAt      DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  customer             Customer                  @relation(fields: [customerId], references: [id])
  application          LoanApplication           @relation(fields: [applicationId], references: [id])
  sanction             Sanction                  @relation(fields: [sanctionId], references: [id])
  requests             DisbursementRequest[]
  beneficiaries        DisbursementBeneficiary[]
  transactions         DisbursementTransaction[]
  history              DisbursementHistory[]
  loans                LoanAccount[]

  @@index([applicationId])
  @@index([sanctionId])
  @@index([customerId])
  @@map("disbursements")
}

model DisbursementRequest {
  id                  String                    @id @default(uuid())
  requestNumber       String                    @unique
  disbursementId      String
  applicationId       String
  sanctionId          String
  requestedAmount     Decimal                   @db.Decimal(14, 2)
  disbursementType    DisbursementType          @default(FULL)
  beneficiaryId       String?
  paymentMethod       PaymentMethod             @default(NEFT)
  purpose             String?
  supportingDocuments Json?
  notes               String?
  status              DisbursementStatus        @default(DRAFT)
  readinessChecks     Json?
  requestedBy         String
  requestedByName     String
  requestedAt         DateTime                  @default(now())
  assignedTo          String?
  assignedToName      String?
  assignedAt          DateTime?
  reviewedBy          String?
  reviewedAt          DateTime?
  approvedBy          String?
  approvedByName      String?
  approvedAt          DateTime?
  approvalNotes       String?
  rejectedBy          String?
  rejectedByName      String?
  rejectedAt          DateTime?
  rejectionReason     String?
  returnedBy          String?
  returnedByName      String?
  returnedAt          DateTime?
  returnReason        String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  disbursement        Disbursement              @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  beneficiary         DisbursementBeneficiary?  @relation(fields: [beneficiaryId], references: [id])
  transactions        DisbursementTransaction[]

  @@index([disbursementId])
  @@map("disbursement_requests")
}

model DisbursementBeneficiary {
  id                   String                @id @default(uuid())
  disbursementId       String
  beneficiaryType      String                @default("PRIMARY_BORROWER")
  beneficiaryName      String
  bankName             String
  accountNumber        String
  accountNumberMasked  String
  ifscCode             String
  accountType          String                @default("SAVINGS")
  verificationStatus   String                @default("VERIFIED")
  verificationSource   String?               @default("KYC_BANK_PROOF")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  disbursement         Disbursement          @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  requests             DisbursementRequest[]

  @@index([disbursementId])
  @@map("disbursement_beneficiaries")
}

model DisbursementTransaction {
  id                             String                @id @default(uuid())
  transactionReference           String                @unique
  disbursementId                 String
  requestId                      String?
  amount                         Decimal               @db.Decimal(14, 2)
  paymentMethod                  PaymentMethod         @default(NEFT)
  status                         TransactionStatus     @default(PENDING)
  beneficiaryName                String
  beneficiaryAccountNumberMasked String
  beneficiaryIfsc                String
  bankName                       String
  externalReference              String?
  utrNumber                      String?
  processingStartedAt            DateTime?
  completedAt                    DateTime?
  failedAt                       DateTime?
  failureReason                  String?
  reversedAt                     DateTime?
  reversedBy                     String?
  reversalReason                 String?
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  disbursement                   Disbursement          @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  request                        DisbursementRequest?  @relation(fields: [requestId], references: [id])

  @@index([disbursementId])
  @@index([requestId])
  @@map("disbursement_transactions")
}

model DisbursementHistory {
  id             String       @id @default(uuid())
  disbursementId String
  requestId      String?
  timestamp      DateTime     @default(now())
  event          String
  actor          String
  actorName      String
