  id              String    @id @default(uuid())
  legalCaseId     String
  eventType       String    // NOTICE_ISSUED, CASE_FILED, SUMMONS_SERVED, HEARING_HELD, EVIDENCE_FILED, INTERIM_ORDER, FINAL_DECREE, WARRANT_ISSUED, ATTACHMENT_ORDER, PAYMENT_RECORDED, SETTLEMENT_REACHED, CASE_CLOSED
  eventDate       String
  actorName       String
  actorRole       String
  notes           String
  referenceNumber String?
  documentUrl     String?
  nextAction      String?
  nextHearingDate String?
  createdAt       DateTime  @default(now())

  legalCase       LegalCase @relation(fields: [legalCaseId], references: [id], onDelete: Cascade)

  @@index([legalCaseId])
  @@map("legal_case_events")
}

model LegalNotice {
  id               String                @id @default(uuid())
  noticeNumber     String                @unique
  loanId           String
  recoveryCaseId   String
  legalCaseId      String?
  customerId       String
  noticeType       String                // SECTION_138_CHEQUE_BOUNCE, LOAN_RECALL_DEMAND, STATUTORY_DEMAND_NOTICE, ARBITRATION_INVOCATION, SARFAESI_13_2_NOTICE
  status           LegalNoticeStatusEnum @default(DRAFT)
  demandAmount     Decimal               @db.Decimal(14, 2)
  noticeDate       String
  curePeriodDays   Int                   @default(15)
  dueDate          String
  recipientName    String
  recipientAddress String
  dispatchMode     String?               // REGISTERED_POST_AD, SPEED_POST, COURIER, EMAIL, HAND_DELIVERY
  trackingNumber   String?
  dispatchedDate   String?
  deliveryDate     String?
  draftContent     String
  preparedBy       String
  preparedByName   String
  approvedBy       String?
  approvedByName   String?
  approvedAt       DateTime?
  dispatchedBy     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  loan             LoanAccount           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  recoveryCase     RecoveryCase          @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  legalCase        LegalCase?            @relation(fields: [legalCaseId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([recoveryCaseId])
  @@index([legalCaseId])
  @@map("legal_notices")
}

// ----------------------------------------------------
// Restructuring, Rescheduling & Moratoriums (Batch 14)
// ----------------------------------------------------

enum RestructuringTypeEnum {
  TENURE_EXTENSION
  EMI_REDUCTION
  EMI_INCREASE
  INTEREST_RATE_CHANGE
  REPAYMENT_FREQUENCY_CHANGE
  MORATORIUM
  PAYMENT_HOLIDAY
  DUE_DATE_CHANGE
  PARTIAL_RESCHEDULING
  FULL_RESCHEDULING
}

enum RestructuringStatusEnum {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  EFFECTIVE
  SUPERSEDED
}

model RestructuringRequest {
  id                             String                  @id @default(uuid())
  requestNumber                  String                  @unique
  loanId                         String
  accountNumber                  String
  customerId                     String
  customerNumber                 String?
  customerName                   String
  requestType                    RestructuringTypeEnum   @default(TENURE_EXTENSION)
  reason                         String
  requestedBy                    String
  requestedByName                String
  requestedByRole                String
  requestedAt                    DateTime                @default(now())
  effectiveDate                  String                  // YYYY-MM-DD
  status                         RestructuringStatusEnum @default(SUBMITTED)
  assignedOfficer                String?
  assignedOfficerId              String?
  branchId                       String                  @default("br_panjim")
  branchName                     String?

  // Current Terms Snapshot
  currentPrincipalOutstanding     Decimal                 @db.Decimal(14, 2)
  currentInterestRate            Decimal                 @db.Decimal(5, 2)
  currentRemainingTenureMonths   Int
  currentEmiAmount               Decimal                 @db.Decimal(14, 2)
  currentRepaymentFrequency      String                  @default("MONTHLY")
  currentNextDueDate             String?
  currentMaturityDate            String?
  currentDpd                     Int                     @default(0)
  currentOverdueAmount           Decimal                 @default(0.00) @db.Decimal(14, 2)
  currentScheduleVersion         Int                     @default(1)

  // Proposed Terms
  proposedPrincipal              Decimal                 @db.Decimal(14, 2)
  proposedInterestRate           Decimal                 @db.Decimal(5, 2)
  proposedTenureMonths           Int
  proposedEmiAmount              Decimal                 @db.Decimal(14, 2)
  proposedRepaymentFrequency     String                  @default("MONTHLY")
  proposedFirstDueDate           String
  proposedMaturityDate           String

  // Specific Moratorium & Treatment Terms
  moratoriumMonths               Int?                    @default(0)
  moratoriumInterestTreatment    String?                 @default("ACCRUE_AND_AMORTIZE") // ACCRUE_AND_AMORTIZE, CAPITALIZE, PAY_INTEREST_ONLY, WAIVE
  moratoriumPrincipalTreatment   String?                 @default("DEFER")
  moratoriumFeeTreatment         String?                 @default("REMAIN_DUE")
  capitalizedAmount              Decimal?                @default(0.00) @db.Decimal(14, 2)
  feeTreatment                   String?                 @default("REMAIN_DUE") // REMAIN_DUE, CAPITALIZED, WAIVED, DEFERRED
  penaltyTreatment               String?                 @default("REMAIN_DUE")

  // Financial Impact (Calculated server-side)
  currentRemainingInterest       Decimal                 @db.Decimal(14, 2)
  proposedRemainingInterest      Decimal                 @db.Decimal(14, 2)
  interestDifference             Decimal                 @db.Decimal(14, 2)
  currentTotalScheduled          Decimal                 @db.Decimal(14, 2)
  proposedTotalScheduled         Decimal                 @db.Decimal(14, 2)
  emiDifference                  Decimal                 @db.Decimal(14, 2)
  tenureDifference               Int

  // Review & Approval Workflow
  reviewedBy                     String?
  reviewedByName                 String?
  reviewedByRole                 String?
  reviewedAt                     DateTime?
  reviewNotes                    String?

  approvedBy                     String?
  approvedByName                 String?
  approvedByRole                 String?
  approvedAt                     DateTime?
  approvalNotes                  String?

  rejectedBy                     String?
  rejectedByName                 String?
  rejectedByRole                 String?
  rejectedAt                     DateTime?
  rejectionReason                String?

  appliedAt                      DateTime?
  appliedBy                      String?
  appliedByName                  String?
  resultingScheduleVersionId     String?
  resultingScheduleVersionNumber Int?

  // Customer Consent Tracking
  consentRequired                Boolean                 @default(true)
  consentReceived                Boolean                 @default(false)
  consentDate                    String?
  consentMethod                  String?                 // DIGITAL_OTP, PHYSICAL_SIGNATURE, E_SIGN, IN_PERSON
  consentDocumentRef             String?

  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt

  loan                           LoanAccount             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer                       Customer                @relation(fields: [customerId], references: [id])
  events                         RestructuringEvent[]
  proposals                      RestructuringProposal[]

  @@index([loanId])
  @@index([customerId])
  @@index([accountNumber])
  @@index([status])
  @@index([requestType])
  @@index([effectiveDate])
  @@index([branchId])
  @@map("restructuring_requests")
}

model RestructuringEvent {
  id                   String               @id @default(uuid())
  requestId            String
  eventType            String               // CREATED, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, CONSENT_RECORDED, APPLIED_EFFECTIVE, CANCELLED
  timestamp            DateTime             @default(now())
  actor                String
  actorName            String
  actorRole            String
  title                String
  description          String?
  metadata             Json?

  restructuringRequest RestructuringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("restructuring_events")
}

model RestructuringProposal {
  id                   String               @id @default(uuid())
  requestId            String
  proposalOptionName   String               // Option A, Option B, etc.
  tenureMonths         Int
  interestRate         Decimal              @db.Decimal(5, 2)
  emiAmount            Decimal              @db.Decimal(14, 2)
  frequency            String               @default("MONTHLY")
  moratoriumMonths     Int                  @default(0)
  totalInterest        Decimal              @db.Decimal(14, 2)
  totalAmount          Decimal              @db.Decimal(14, 2)
  isRecommended        Boolean              @default(false)
  isSelected           Boolean              @default(false)
  schedulePreview      Json?
  createdAt            DateTime             @default(now())

  restructuringRequest RestructuringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("restructuring_proposals")
}

// ----------------------------------------------------
// Charges, Waivers & Financial Adjustments (Batch 15)
// ----------------------------------------------------

model ChargeConfiguration {
  id               String   @id @default(uuid())
  chargeCode       String   @unique // e.g. LATE_FEE_MONTHLY, BOUNCE_FEE_NACH, LEGAL_NOTICE_FEE, PROCESSING_FEE
  chargeName       String
  chargeType       String   // LATE_PAYMENT_FEE, BOUNCE_FEE, COLLECTION_FEE, LEGAL_FEE, NOTICE_FEE, PROCESSING_FEE, OTHER_FEE
  calculationBasis String   @default("FIXED_AMOUNT") // FIXED_AMOUNT, PERCENTAGE_OF_PRINCIPAL, PERCENTAGE_OF_OVERDUE, PER_INSTALMENT, PER_EVENT, PER_DAY
  rateOrValue      Decimal  @db.Decimal(10, 2)
  taxPercentage    Decimal  @default(18.00) @db.Decimal(5, 2) // e.g. 18% GST
  minAmount        Decimal? @db.Decimal(14, 2)
  maxAmount        Decimal? @db.Decimal(14, 2)
  applicableEvent  String?  // PAYMENT_LATE, PAYMENT_RETURNED, NOTICE_ISSUED, LEGAL_CASE_FILED, MANUAL
  isWaivable       Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("charge_configurations")
}

model WaiverRequest {
  id                       String      @id @default(uuid())
  waiverNumber             String      @unique // e.g. WVR-2026-000101
  loanId                   String
  customerId               String
  accountNumber            String
  customerName             String
  chargeId                 String?
  waiverType               String      @default("PARTIAL_WAIVER") // FULL_WAIVER, PARTIAL_WAIVER, FEE_WAIVER, PENALTY_WAIVER, INTEREST_WAIVER, CHARGE_REVERSAL
  category                 String      @default("FEE") // FEE, PENALTY, INTEREST
  requestedAmount          Decimal     @db.Decimal(14, 2)
  approvedAmount           Decimal?    @db.Decimal(14, 2)
  eligibleOutstandingBefore Decimal   @db.Decimal(14, 2)
  reason                   String
  status                   String      @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, APPLIED, CANCELLED
  requestedBy              String
  requestedByName          String
  requestedByRole          String
  requestedAt              DateTime    @default(now())
  reviewedBy               String?
  reviewedByName           String?
  reviewedAt               DateTime?
  approvedBy               String?
  approvedByName           String?
  approvedByRole           String?
  approvedAt               DateTime?
  approvalNotes            String?
  rejectedBy               String?
  rejectedByName           String?
  rejectedAt               DateTime?
  rejectionReason          String?
  appliedAt                DateTime?
  appliedBy                String?
  resultingTransactionRef  String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  loan                     LoanAccount @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer                 Customer    @relation(fields: [customerId], references: [id])
  charge                   LoanCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([customerId])
  @@index([accountNumber])
  @@index([chargeId])
  @@index([status])
  @@index([waiverType])
  @@map("waiver_requests")
}

model FinancialAdjustmentRequest {
  id                      String      @id @default(uuid())
  adjustmentNumber        String      @unique // e.g. ADJ-2026-000101
  loanId                  String
  customerId              String
  accountNumber           String
  customerName            String
  adjustmentType          String      @default("CREDIT_ADJUSTMENT") // DEBIT_ADJUSTMENT, CREDIT_ADJUSTMENT, FEE_ADJUSTMENT, INTEREST_ADJUSTMENT, PENALTY_ADJUSTMENT
  amount                  Decimal     @db.Decimal(14, 2)
  principalAdjustment     Decimal     @default(0.00) @db.Decimal(14, 2)
  interestAdjustment      Decimal     @default(0.00) @db.Decimal(14, 2)
  feeAdjustment           Decimal     @default(0.00) @db.Decimal(14, 2)
  penaltyAdjustment       Decimal     @default(0.00) @db.Decimal(14, 2)
  effectiveDate           String
  reason                  String
  reference               String?
  status                  String      @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, APPLIED, CANCELLED, REVERSED
  requestedBy             String
  requestedByName         String
  requestedByRole         String
  requestedAt             DateTime    @default(now())
  approvedBy              String?
  approvedByName          String?
  approvedByRole          String?
  approvedAt              DateTime?
  approvalNotes           String?
  rejectedBy              String?
  rejectedByName          String?
  rejectedAt              DateTime?
  rejectionReason         String?
  appliedAt               DateTime?
  appliedBy               String?
  resultingTransactionRef String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  loan                    LoanAccount @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer                Customer    @relation(fields: [customerId], references: [id])

  @@index([loanId])
  @@index([customerId])
  @@index([accountNumber])
  @@index([status])
  @@index([adjustmentType])
  @@map("financial_adjustment_requests")
}

model AdjustmentReversal {
  id                         String      @id @default(uuid())
  reversalNumber             String      @unique // e.g. REV-2026-000101
  targetType                 String      // CHARGE, WAIVER, ADJUSTMENT, TRANSACTION
  targetId                   String
  targetReference            String
  loanId                     String
  amount                     Decimal     @db.Decimal(14, 2)
  reason                     String
  status                     String      @default("COMPLETED")
  requestedBy                String
  requestedByName            String
  approvedBy                 String?
  approvedByName             String?
  reversedAt                 DateTime    @default(now())
  compensatingTransactionRef String
  notes                      String?
  createdAt                  DateTime    @default(now())

  loan                       LoanAccount @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([targetId])
  @@index([targetType])
  @@map("adjustment_reversals")
}

// ----------------------------------------------------
// Settlement, Foreclosure, Loan Closure & NOC (Batch 16)
// ----------------------------------------------------

model LoanClosureRequest {
  id                           String              @id @default(uuid())
  requestNumber                String              @unique // e.g. CLR-2026-000101
  loanId                       String
  customerId                   String
  accountNumber                String
  customerName                 String
  closureType                  String              @default("FORECLOSURE") // FORECLOSURE, SETTLEMENT, NORMAL_CLOSURE, VOLUNTARY_CLOSURE
  status                       String              @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, PAYMENT_PENDING, RECONCILED, CLOSED, CANCELLED, EXPIRED
  calculationDate              String
  effectiveDate                String
  requestedBy                  String
  requestedByName              String
  requestedByRole              String
  requestedAt                  DateTime            @default(now())
  reason                       String
  assignedOfficer              String?
  assignedOfficerId            String?
  branchId                     String?
  branchName                   String?

  // Financial Exposure Snapshot
  principalOutstanding        Decimal             @db.Decimal(14, 2)
  interestOutstanding         Decimal             @db.Decimal(14, 2)
  feeOutstanding              Decimal             @db.Decimal(14, 2)
  penaltyOutstanding          Decimal             @db.Decimal(14, 2)
  totalExposure               Decimal             @db.Decimal(14, 2)

  // Calculations & Quotes
  foreclosureChargeAmount      Decimal             @default(0.00) @db.Decimal(14, 2)
  foreclosureChargeTax         Decimal             @default(0.00) @db.Decimal(14, 2)
  waiverAmount                 Decimal             @default(0.00) @db.Decimal(14, 2)
  concessionAmount             Decimal             @default(0.00) @db.Decimal(14, 2)
  finalPayableAmount           Decimal             @db.Decimal(14, 2)
  paidAmount                   Decimal             @default(0.00) @db.Decimal(14, 2)
  quoteValidUntil              String?

  // Maker-Checker & Approvals
  reviewedBy                   String?
  reviewedByName               String?
  reviewedAt                   DateTime?
  approvedBy                   String?
  approvedByName               String?
  approvedByRole               String?
  approvedAt                   DateTime?
  approvalNotes                String?
  rejectedBy                   String?
  rejectedByName               String?
  rejectedAt                   DateTime?
  rejectionReason              String?
  closedAt                     DateTime?
  closedBy                     String?
  closureNotes                 String?

  // Reconciliation References
  reconciliationTransactionRef String?
  concessionAdjustmentRef      String?

  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  loan                         LoanAccount         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer                     Customer            @relation(fields: [customerId], references: [id])
  foreclosureQuote             ForeclosureQuote?
  settlementProposal           SettlementProposal?
  nocRecord                    NocRecord?
  events                       ClosureEvent[]

  @@index([loanId])
  @@index([customerId])
  @@index([accountNumber])
  @@index([status])
  @@index([closureType])
  @@map("loan_closure_requests")
}

model ForeclosureQuote {
  id                    String             @id @default(uuid())
  quoteNumber           String             @unique // e.g. FCQ-2026-000101
  closureRequestId      String             @unique
  loanId                String
  quoteDate             String
  validUntil            String
  principalOutstanding Decimal            @db.Decimal(14, 2)
  accruedInterest       Decimal            @db.Decimal(14, 2)
  feesDue               Decimal            @db.Decimal(14, 2)
  penaltiesDue          Decimal            @db.Decimal(14, 2)
  foreclosureFeeRate    Decimal            @default(2.00) @db.Decimal(5, 2)
  foreclosureFeeAmount  Decimal            @db.Decimal(14, 2)
  foreclosureFeeTax     Decimal            @default(0.00) @db.Decimal(14, 2)
  totalForeclosureCharge Decimal           @db.Decimal(14, 2)
  approvedWaivers       Decimal            @default(0.00) @db.Decimal(14, 2)
  netPayableAmount      Decimal            @db.Decimal(14, 2)
  status                String             @default("ACTIVE") // ACTIVE, EXPIRED, ACCEPTED, SUPERSEDED
  generatedBy           String
  createdAt             DateTime           @default(now())

  closureRequest        LoanClosureRequest @relation(fields: [closureRequestId], references: [id], onDelete: Cascade)
  loan                  LoanAccount        @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([closureRequestId])
  @@map("foreclosure_quotes")
}

model SettlementProposal {
  id                      String             @id @default(uuid())
  proposalNumber          String             @unique // e.g. SET-2026-000101
  closureRequestId        String             @unique
  loanId                  String
  totalExposure           Decimal            @db.Decimal(14, 2)
  proposedSettlementAmount Decimal           @db.Decimal(14, 2)
  concessionAmount        Decimal            @db.Decimal(14, 2)
  concessionPercentage    Decimal            @db.Decimal(5, 2)
  principalConcession     Decimal            @default(0.00) @db.Decimal(14, 2)
  interestConcession      Decimal            @default(0.00) @db.Decimal(14, 2)
  feePenaltyConcession    Decimal            @default(0.00) @db.Decimal(14, 2)
  paymentDeadline         String
  settlementReason        String
  hardshipCategory        String?
  status                  String             @default("PROPOSED") // PROPOSED, APPROVED, REJECTED, PAID, DEFAULTED
  createdAt               DateTime           @default(now())

  closureRequest          LoanClosureRequest @relation(fields: [closureRequestId], references: [id], onDelete: Cascade)
  loan                    LoanAccount        @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([closureRequestId])
  @@map("settlement_proposals")
}

model NocRecord {
  id                  String             @id @default(uuid())
  nocNumber           String             @unique // e.g. NOC-2026-000101
  loanId              String             @unique
  customerId          String
  accountNumber       String
  customerName        String
  closureRequestId    String             @unique
  closureType         String
  closureDate         String
  sanctionedAmount    Decimal            @db.Decimal(14, 2)
  disbursedAmount     Decimal            @db.Decimal(14, 2)
  totalRecoveredAmount Decimal           @db.Decimal(14, 2)
  status              String             @default("READY") // PENDING_ELIGIBILITY, READY, GENERATED, APPROVED, ISSUED, CANCELLED
  documentReference   String?
  generatedAt         DateTime?
  generatedBy         String?
  approvedAt          DateTime?
  approvedBy          String?
  issuedAt            DateTime?
  issuedBy            String?
  deliveryMethod      String?
  dispatchAddress     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  closureRequest      LoanClosureRequest @relation(fields: [closureRequestId], references: [id], onDelete: Cascade)
  loan                LoanAccount        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer            Customer           @relation(fields: [customerId], references: [id])

  @@index([loanId])
  @@index([customerId])
  @@index([closureRequestId])
  @@index([status])
  @@map("noc_records")
}

model ClosureEvent {
  id               String             @id @default(uuid())
  closureRequestId String
  eventType        String
  timestamp        DateTime           @default(now())
  actor            String
  actorName        String
  actorRole        String
  title            String
  description      String
  amount           Decimal?           @db.Decimal(14, 2)

  closureRequest   LoanClosureRequest @relation(fields: [closureRequestId], references: [id], onDelete: Cascade)

  @@index([closureRequestId])
  @@map("closure_events")
}

// ----------------------------------------------------
// Custom Application Form Builder (Templates, Versions & Responses)
// ----------------------------------------------------

model ApplicationFormTemplate {
  id             String                   @id @default(uuid())
  productId      String
  title          String
  description    String?
  status         String                   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  currentVersion Int                      @default(1)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  product        LoanProduct              @relation(fields: [productId], references: [id], onDelete: Cascade)
  versions       ApplicationFormVersion[]

  @@index([productId])
  @@map("application_form_templates")
}

model ApplicationFormVersion {
  id             String                        @id @default(uuid())
  formTemplateId String
  versionNumber  Int
  status         String                        @default("PUBLISHED") // DRAFT, PUBLISHED, SUPERSEDED, ARCHIVED
  schemaJson     Json                          // Complete multi-page schema with sections, columns, fields, conditions
  publishedAt    DateTime?
  publishedBy    String?
  changeSummary  String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  formTemplate   ApplicationFormTemplate       @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  responses      LoanApplicationFormResponse[]

  @@index([formTemplateId])
  @@index([versionNumber])
  @@map("application_form_versions")
}

model LoanApplicationFormResponse {
  id                   String                 @id @default(uuid())
  applicationId        String                 @unique
  formVersionId        String
  productId            String
  responses            Json                   // Map of fieldId -> response value
  signatures           Json?                  // Map of fieldId -> { signatureDataUrl, signedAt, signerName, ipAddress }
  uploadedDocumentIds  Json?                  // Map of fieldId -> Array of doc references
  completionPercentage Decimal                @default(0.00) @db.Decimal(5, 2)
  currentPageIndex     Int                    @default(0)
  isSubmitted          Boolean                @default(false)
  submittedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  application          LoanApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  formVersion          ApplicationFormVersion @relation(fields: [formVersionId], references: [id])

  @@index([applicationId])
  @@index([formVersionId])
  @@index([productId])
  @@map("loan_application_form_responses")
}






