# ==============================================================================
# FinTech Enterprise Loan Management System (LMS) — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Provider Toggle
# ------------------------------------------------------------------------------
# Choose which database to connect to:
#   - "postgres" : Uses local / standard PostgreSQL (Docker, Podman, or Native PG)
#   - "supabase" : Uses Supabase Cloud Database (Pooled + Direct URLs)
DB_PROVIDER="postgres"

# ------------------------------------------------------------------------------
# 2. Option A: Supabase Cloud Database
# ------------------------------------------------------------------------------
# In your Supabase Dashboard -> Project Settings -> Database:
#
# A) Pooled Connection (Supavisor / Transaction Mode, Port 6543):
#    Used for Next.js runtime API routes, user logins, and loan queries.
SUPABASE_DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# B) Direct Connection (Session Mode, Port 5432):
#    Used strictly for Prisma schema synchronization ('npx prisma db push' or 'prisma migrate')
SUPABASE_DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional: Supabase API credentials (if using Supabase Auth or Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"

# ------------------------------------------------------------------------------
# 3. Option B: Standard / Local PostgreSQL (Docker, Podman, or Local Machine)
# ------------------------------------------------------------------------------
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="loan_ms_db"

# Standard PostgreSQL URL (used when DB_PROVIDER="postgres")
POSTGRES_DATABASE_URL="postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}?schema=public"

# Active Default DATABASE_URL (Standard fallback for Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loan_ms_db?schema=public"

# ------------------------------------------------------------------------------
# 4. Connection Pool Configuration (Optional)
# ------------------------------------------------------------------------------
# Maximum concurrent connections per serverless / Next.js instance:
#   - Local Postgres: 10
#   - Supabase Transaction Pooler (port 6543): 10-20
#   - Prisma Cloud Free Tier (prisma_migration): 1
PGMAX_CONNECTIONS=10

# ------------------------------------------------------------------------------
# 5. Security & Authentication
# ------------------------------------------------------------------------------
AUTH_SECRET="fintech-lms-jwt-secret-key-replace-in-production-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
